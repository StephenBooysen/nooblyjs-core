# Dependencies
node_modules/

# Application data (runtime files written by the app)
.application/
.cache/
.data/
documents/
documents-readonly/
documents-shared/

# Build output and Electron
dist/

# Logs
*.log
.logs/

# Environment files (keep the example)
.env
*.env.*
!.env.example

# TLS certificates (dev self-signed; never commit private keys)
certs/
*.key
*.crt
*.pem

# Tests and their output
.test/
screenshots/

# Shell scripts are ignored by default; add an exception if one must be committed
*.sh

# OS and editor files
.DS_Store

# Local working docs and ad-hoc test output
.temp/
