  "paths": {
    "/register": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Register (closed)",
        "description": "Open registration is closed: this answers 403. People join through an invitation.",
        "operationId": "postRegister",
        "security": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Not allowed for this caller"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Sign in",
        "description": "Checks the email and password and sets the httpOnly session cookie. Rate-limited per IP, with a lockout per account. `returnUrl` (same-origin path only) is where the browser goes next.",
        "operationId": "postLogin",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "returnUrl": {
                    "type": "string",
                    "maxLength": 2048
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "No valid session, API key or token"
          },
          "429": {
            "description": "Too many requests"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/auth/check": {
      "get": {
        "tags": [
          "Session"
        ],
        "summary": "Is this browser signed in?",
        "description": "Reports whether the session cookie belongs to a signed-in user. Reveals nothing beyond `authenticated: false` to an anonymous caller.",
        "operationId": "getAuthCheck",
        "security": [],
        "responses": {
          "200": {
