        "parameters": [
          {
            "name": "taskName",
            "in": "query",
            "required": false,
            "description": "Only runs of this task",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Only runs with this status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
