  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal access token"
      }
    }
  },
  "paths": {
    "/tasks": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "List scheduled tasks",
        "description": "Every task with its cadence, state and next run, soonest first.",
        "operationId": "getTasks",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "No valid session, API key or token"
          },
          "403": {
            "description": "Not allowed for this caller"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-permission": "scheduling:read"
      },
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Create a task",
        "description": "Creates a task that runs a script on a cron expression or every N seconds. An interval task first runs one interval after creation.",
        "operationId": "postTasks",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Unique task name"
                  },
                  "scriptPath": {
                    "type": "string",
                    "description": "Script to run, inside the allowed script folders"
                  },
                  "cronExpression": {
                    "type": "string",
                    "description": "Five-field cron expression (or give intervalSeconds)"
                  },
                  "intervalSeconds": {
                    "type": "number",
                    "description": "Run every N seconds (or give cronExpression)"
                  },
                  "data": {
                    "type": "object",
                    "description": "Data passed to the script"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description"
                  },
                  "group": {
                    "type": "string",
                    "description": "Group name"
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Start enabled (default true)"
                  }
                },
                "required": [
                  "name",
                  "scriptPath"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "No valid session, API key or token"
          },
          "403": {
            "description": "Not allowed for this caller"
          },
          "500": {
            "description": "Server error"
          }
        },
        "x-permission": "jobs:run"
      }
    },
