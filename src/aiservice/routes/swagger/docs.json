{
  "openapi": "3.0.0",
  "info": {
    "title": "AI Service API",
    "description": "REST API for AI service operations with multi-instance support. Each named instance is a separate AI provider configuration; omit the instance segment to target the default instance.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/services/ai/api",
      "description": "AI Service API"
    }
  ],
  "tags": [
    {
      "name": "Default Instance",
      "description": "Operations on the default AI service instance"
    },
    {
      "name": "Named Instance",
      "description": "Operations on a named AI service instance"
    },
    {
      "name": "Training",
      "description": "Training"
    }
  ],
  "components": {
    "parameters": {
      "InstanceName": {
        "name": "instanceName",
        "in": "path",
        "required": true,
        "description": "Name of the AI service instance",
        "schema": {
          "type": "string",
          "example": "default"
        }
      }
    },
    "requestBodies": {
      "PromptBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "prompt"
              ],
              "properties": {
                "prompt": {
                  "type": "string",
                  "example": "Please give me an inspiring quote"
                },
                "username": {
                  "type": "string",
                  "description": "Optional username for analytics attribution",
                  "example": "anonymous"
                },
                "options": {
                  "type": "object",
                  "properties": {
                    "maxTokens": {
                      "type": "integer",
                      "example": 1000
                    },
                    "temperature": {
                      "type": "number",
                      "example": 0.7
                    }
                  }
                }
              }
            }
          }
        }
      },
      "SettingsBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "Key/value map of settings to update"
            }
          }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Successful response"
      },
      "BadRequest": {
        "description": "Invalid request"
      },
      "ServiceDisabled": {
        "description": "AI service is disabled - API key not configured"
      },
      "ServerError": {
        "description": "Internal server error"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal access token"
      }
    }
  },
  "paths": {
    "/instances": {
      "get": {
        "tags": [
          "Default Instance"
        ],
        "summary": "List all AI service instances",
        "description": "Returns every registered AI service instance, including the default.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/status": {
      "get": {
        "tags": [
          "Default Instance"
        ],
        "summary": "Get service status",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/prompt": {
      "post": {
        "tags": [
          "Default Instance"
        ],
        "summary": "Send a prompt to the default instance",
        "requestBody": {
          "$ref": "#/components/requestBodies/PromptBody"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceDisabled"
          }
        }
      }
    },
    "/complete": {
      "post": {
        "tags": [
          "Default Instance"
        ],
        "summary": "Run one request and wait for the whole reply",
        "description": "Returns text, toolCalls, stopReason, usage and model.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "messages"
                ],
                "properties": {
                  "messages": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {}
                      }
                    }
                  },
                  "system": {
                    "type": "string"
                  },
                  "maxTokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Token limit or daily cost budget exceeded"
          },
          "501": {
            "description": "Not available for a legacy provider"
          }
        }
      }
    },
    "/stream": {
      "post": {
        "tags": [
          "Default Instance"
        ],
        "summary": "Stream a reply as server-sent events",
        "description": "Events: text ({text}), done ({stopReason}), error.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "messages"
                ],
                "properties": {
                  "messages": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {}
                      }
                    }
                  },
                  "system": {
                    "type": "string"
                  },
                  "maxTokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Token limit or daily cost budget exceeded"
          },
          "501": {
            "description": "Not available for a legacy provider"
          }
        }
      }
    },
    "/generate-object": {
      "post": {
        "tags": [
          "Default Instance"
        ],
        "summary": "Ask for a JSON object matching a schema",
        "description": "422 when the reply is not valid JSON for the schema.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "messages",
                  "schema"
                ],
                "properties": {
                  "messages": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {}
                      }
                    }
                  },
                  "system": {
                    "type": "string"
                  },
                  "maxTokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "schema": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Token limit or daily cost budget exceeded"
          },
          "501": {
            "description": "Not available for a legacy provider"
          }
        }
      }
    },
    "/embed": {
      "post": {
        "tags": [
          "Default Instance"
        ],
        "summary": "Embed texts",
        "description": "Returns vectors in input order, model and usage. Providers without embeddings (anthropic, azure) answer 400 unless the instance sets an embeddings provider.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "texts"
                ],
                "properties": {
                  "texts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "maxLength": 32000
                    }
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "model": {
                        "type": "string"
                      },
                      "dimensions": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8192
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Token limit or daily cost budget exceeded"
          },
          "501": {
            "description": "Not available for a legacy provider"
          }
        }
      }
    },
    "/analytics": {
      "get": {
        "tags": [
          "Default Instance"
        ],
        "summary": "Get prompt analytics",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "recentLimit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/models": {
      "get": {
        "tags": [
          "Default Instance"
        ],
        "summary": "List available models",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Default Instance"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/settings": {
      "get": {
        "tags": [
          "Default Instance"
        ],
        "summary": "Get service settings",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Default Instance"
        ],
        "summary": "Save service settings",
        "requestBody": {
          "$ref": "#/components/requestBodies/SettingsBody"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/{instanceName}/status": {
      "get": {
        "tags": [
          "Named Instance"
        ],
        "summary": "Get status for an instance",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstanceName"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/{instanceName}/prompt": {
      "post": {
        "tags": [
          "Named Instance"
        ],
        "summary": "Send a prompt to a named instance",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstanceName"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/PromptBody"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceDisabled"
          }
        }
      }
    },
    "/{instanceName}/analytics": {
      "get": {
        "tags": [
          "Named Instance"
        ],
        "summary": "Get analytics for an instance",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstanceName"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "recentLimit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/{instanceName}/models": {
      "get": {
        "tags": [
          "Named Instance"
        ],
        "summary": "List models for an instance",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstanceName"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/{instanceName}/health": {
      "get": {
        "tags": [
          "Named Instance"
        ],
        "summary": "Health check for an instance",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstanceName"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        }
      }
    },
    "/{instanceName}/settings": {
      "get": {
        "tags": [
          "Named Instance"
        ],
        "summary": "Get settings for an instance",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstanceName"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Named Instance"
        ],
        "summary": "Save settings for an instance",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstanceName"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/SettingsBody"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/train/status": {
      "get": {
        "tags": [
          "Training"
        ],
        "summary": "Training status",
        "description": "Whether the provider supports training and how many examples it holds (TensorFlow and OpenAI key/value providers).",
        "operationId": "getTrainStatus",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "No valid session, API key or token"
          },
          "403": {
            "description": "Not allowed for this caller"
          }
        },
        "x-permission": "ai:read"
      }
    },
    "/train/data": {
      "get": {
        "tags": [
          "Training"
        ],
        "summary": "List training examples",
        "operationId": "getTrainData",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "No valid session, API key or token"
          },
          "403": {
            "description": "Not allowed for this caller"
          }
        },
        "x-permission": "ai:read"
      },
      "post": {
        "tags": [
          "Training"
        ],
        "summary": "Add a training example",
        "operationId": "postTrainData",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Example key"
                  },
                  "text": {
                    "type": "string",
                    "description": "Example text"
                  }
                },
                "required": [
                  "key",
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "No valid session, API key or token"
          },
          "403": {
            "description": "Not allowed for this caller"
          }
        },
        "x-permission": "ai:write"
      }
    },
    "/train/data/{key}": {
      "delete": {
        "tags": [
          "Training"
        ],
        "summary": "Delete a training example",
        "operationId": "deleteTrainDataByKey",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "No valid session, API key or token"
