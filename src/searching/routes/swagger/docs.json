              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "Search text"
                  },
                  "fields": {
                    "type": "array",
                    "description": "Fields to search"
                  },
                  "boost": {
                    "type": "object",
                    "description": "Field weights"
                  },
                  "prefix": {
                    "type": "boolean",
                    "description": "Match word prefixes"
                  },
                  "fuzzy": {
                    "type": "number",
                    "description": "Edit distance for fuzzy matching"
                  },
                  "combineWith": {
                    "type": "string",
                    "description": "AND or OR"
                  },
                  "maxResults": {
                    "type": "integer",
                    "description": "Most results"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "No valid session, API key or token"
