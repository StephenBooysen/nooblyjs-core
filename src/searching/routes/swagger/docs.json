{
  "openapi": "3.0.0",
  "info": {
    "title": "Searching Service API",
    "description": "Full-text and meaning-based search. This document covers the semantic search routes (feature 01); the other searching routes are not yet described here.",
    "version": "1.0.14"
  },
  "servers": [{ "url": "/services/searching/api", "description": "Searching Service API" }],
  "tags": [{ "name": "Semantic search", "description": "Meaning-based search with a vector index" }],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-api-key", "description": "API key for authentication" },
      "BearerAuth": { "type": "http", "scheme": "bearer", "description": "Personal access token" }
    }
  },
  "paths": {
    "/semantic": {
      "get": {
        "tags": ["Semantic search"],
        "summary": "Search by meaning",
        "description": "Ranks documents by vector similarity (`mode=semantic`) or by a fusion of keyword and vector ranking (`mode=hybrid`, the default). Needs the vector search provider; other providers answer 400.",
        "operationId": "semanticSearch",
        "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
        "parameters": [
          { "name": "query", "in": "query", "required": true, "description": "The question or phrase", "schema": { "type": "string", "minLength": 1, "maxLength": 500 } },
          { "name": "index", "in": "query", "required": false, "description": "Index to search", "schema": { "type": "string", "maxLength": 200 } },
          { "name": "limit", "in": "query", "required": false, "description": "Most results to return (1 to 100, default 10)", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
          { "name": "mode", "in": "query", "required": false, "description": "hybrid (default) or semantic", "schema": { "type": "string", "enum": ["hybrid", "semantic"] } }
        ],
        "responses": {
          "200": {
            "description": "Ranked documents",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "mode": { "type": "string", "enum": ["hybrid", "semantic"] }, "data": { "type": "array", "items": { "type": "object" } } } } } }
          },
          "400": { "description": "Invalid query, or the provider has no semantic search" }
        }
      }
    }
  }
}
