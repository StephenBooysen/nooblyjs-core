                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing queue name",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/services/queueing/api/size/{queueName}": {
      "get": {
        "tags": ["Queue Operations"],
        "summary": "Get queue size",
