        "parameters": [
          { "name": "queueName", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Counts by state", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object", "additionalProperties": { "type": "integer" } } } } } } },
          "500": { "description": "Server error" }
        }
      }
    },
    "/services/queueing/api/{instanceName}/queues/{queueName}/job-counts": {
      "get": {
        "tags": [
          "Reliable Jobs"
        ],
        "summary": "Count reliable jobs by state (named instance)",
        "description": "Counts a queue's reliable jobs by state.",
        "operationId": "getReliableJobCounts",
        "parameters": [
          {
            "name": "instanceName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
