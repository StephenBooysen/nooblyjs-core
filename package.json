{
  "name": "nooblyjs-core",
  "version": "1.0.10",
  "description": "A powerful set of modular Node.js backend services with singleton pattern - caching, logging, fetching, data serving, filing, measuring, notifying, queueing, scheduling, searching, workflow, and working services.",
  "keywords": [
    "nodejs",
    "backend",
    "services",
    "microservices",
    "cache",
    "logging",
    "queue",
    "workflow",
    "express"
  ],
  "files": [
    "src",
    "types",
    "public",
    "README.md",
    "package.json",
    "index.js",
    "bin"
  ],
  "license": "ISC",
  "author": "NooblyJS Contributors",
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "nooblyjs": "bin/nooblyjs.js"
  },
  "types": "types/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nooblyjs/nooblyjs-core.git"
  },
  "scripts": {
    "clean": "rimraf node_modules dist",
    "build": "node ./scripts/build.js",
    "start": "node ./app.js",
    "dev": "nodemon --watch ./src ./app.js",
    "dev:noauth": "nodemon --watch ./src ./app-noauth.js",
    "kill": "node scripts/kill-port.js",
    "kill-test": "node scripts/kill-test-port.js",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "probe": "node scripts/probe.js",
    "check:types": "tsc -p types/tests",
    "test:ai-common": "node --test \"tests/unit/aiservice/common/**/*.test.js\"",
    "check:ai-common": "tsc -p src/aiservice/common",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed --project=chromium",
    "test:ui:report": "playwright show-report .temp/tests/playwright/report",
    "coverage": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage"
  },
  "jest": {
    "modulePaths": [
      "./"
    ],
    "transform": {},
    "forceExit": true,
    "detectOpenHandles": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/ui/",
      "<rootDir>/.temp/",
      "<rootDir>/tests/unit/aiservice/common/"
    ],
    "coverageDirectory": ".temp/coverage",
    "coverageReporters": [
      "text-summary",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "index.js",
      "src/**/*.js",
      "!src/**/views/**",
      "!src/**/scripts/**",
      "!src/aiservice/common/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 75,
        "branches": 64,
        "functions": 77,
        "lines": 76
      }
    },
    "setupFiles": [
      "<rootDir>/tests/helpers/jestSetup.js"
    ],
    "globalSetup": "<rootDir>/tests/helpers/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/helpers/globalTeardown.js"
  },
  "overrides": {
    "uuid": "$uuid",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@aws-sdk/client-s3": "^3.614.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@google-cloud/storage": "^5.18.3",
    "@google-cloud/tasks": "^6.2.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "amqplib": "^0.10.9",
    "ftp": "^0.3.10",
    "ioredis-mock": "^8.9.0",
    "javascript-obfuscator": "^5.4.2",
    "jest": "^30.0.3",
    "knip": "^6.12.2",
    "memjs": "^1.3.0",
    "mongodb": "^6.19.0",
    "nock": "^13.5.6",
    "nodemon": "^3.1.10",
    "passport-azure-ad": "^4.3.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.4",
    "rimraf": "^6.0.1",
    "selfsigned": "^5.5.0",
    "stompit": "^1.0.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.17.3",
    "helmet": "^8.2.0",
    "ioredis": "^5.6.1",
    "js-yaml": "^4.3.2",
    "multer": "^2.4.0",
    "node-fetch": "^3.3.2",
    "openai": "^5.23.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "simple-git": "^4.0.2",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.614.0",
    "@aws-sdk/client-sqs": "^3.614.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-queue": "^12.0.0",
    "@google-cloud/storage": "^5.18.3",
    "@google-cloud/tasks": "^6.2.2",
    "@tensorflow/tfjs-node": "^4.22.0",
    "amqplib": "^0.10.9",
    "aws-sdk": "^2.1692.0",
    "ftp": "^0.3.10",
    "memjs": "^1.3.0",
    "mongodb": "^6.19.0",
    "nodemailer": "^10.5.0",
    "passport-azure-ad": "^4.3.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.4",
    "stompit": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "@azure/keyvault-secrets": {
      "optional": true
    },
    "@azure/storage-queue": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    },
    "@google-cloud/tasks": {
      "optional": true
    },
    "@tensorflow/tfjs-node": {
      "optional": true
    },
    "amqplib": {
      "optional": true
    },
    "aws-sdk": {
      "optional": true
    },
    "ftp": {
      "optional": true
    },
    "memjs": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "passport-azure-ad": {
      "optional": true
    },
    "passport-google-oauth20": {
      "optional": true
    },
    "pdf-parse": {
      "optional": true
    },
    "stompit": {
      "optional": true
    }
  },
  "allowScripts": {
    "dtrace-provider@0.8.8": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.11.1": true
  }
}
